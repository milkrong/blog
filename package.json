{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_SKIP_DB=1 next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@opennextjs/cloudflare": "1.20.19",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.51.0",
    "@tiptap/extension-code-block-lowlight": "^3.4.1",
    "@tiptap/extension-image": "^3.4.1",
    "@tiptap/extension-link": "^3.4.1",
    "@tiptap/react": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "lowlight": "^3.3.0",
    "next": "^15.5.29",
    "postgres": "^3.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "latest",
    "drizzle-kit": "^0.31.4",
    "eslint": "8",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "wrangler": "4.168.0"
  }
}