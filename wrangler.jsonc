{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    // Node APIs used by postgres.js, jsonwebtoken, bcryptjs, and the AWS SDK.
    // https://developers.cloudflare.com/workers/runtime-apis/nodejs/
    "nodejs_compat",
    // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "blog"
    }
  ],
  // Incremental cache for ISR. Create the bucket before deploy:
  //   npx wrangler r2 bucket create blog-incremental-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // PLACEHOLDER bucket name. Replace if you create a different bucket.
      "bucket_name": "blog-incremental-cache"
    }
  ],
  // Time-based revalidation queue. The class is exported by the OpenNext worker.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // PLACEHOLDER — not a real Hyperdrive configuration.
      // Replace with the id from `npx wrangler hyperdrive create`.
      "id": "00000000-0000-0000-0000-000000000000",
      // Local `next dev` / `wrangler dev` only. Production uses the Hyperdrive id.
      // Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  // Non-secret configuration. Do not put keys or the database URL here.
  "vars": {
    // PLACEHOLDER. Cloudflare account id that owns the uploads bucket.
    "R2_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    // PLACEHOLDER. Bucket that receives presigned image uploads (not the ISR cache bucket).
    "R2_BUCKET": "REPLACE_WITH_UPLOADS_BUCKET_NAME",
    // PLACEHOLDER. Public read origin (custom domain or r2.dev), not the S3 API host.
    "R2_PUBLIC_BASE_URL": "https://REPLACE_WITH_PUBLIC_R2_HOST",
    // Set to "false" to disable registration. The server reads this at request time.
    "REGISTRATION_ENABLED": "true"
  }
}
