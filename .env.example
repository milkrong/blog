# Local Next.js (`pnpm dev`) and drizzle-kit. The Worker does not use DATABASE_URL;
# production traffic goes through the HYPERDRIVE binding.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# At least 32 characters. Production: `npx wrangler secret put JWT_SECRET`
JWT_SECRET=

# If unset, the server falls back to a hardcoded secret and registration stays on.
# Production: `npx wrangler secret put REGISTRATION_SECRET`
# Set REGISTRATION_ENABLED=false to refuse new accounts.
REGISTRATION_SECRET=
REGISTRATION_ENABLED=true

# Presigned uploads. Access keys are secrets in production:
#   npx wrangler secret put R2_ACCESS_KEY_ID
#   npx wrangler secret put R2_SECRET_ACCESS_KEY
# Account id, bucket, and public base URL are wrangler.jsonc vars.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read origin. Not https://<account>.r2.cloudflarestorage.com.
R2_PUBLIC_BASE_URL=

# `pnpm build` sets this so the build does not need a database.
# NEXT_SKIP_DB=1
